# Tankada production deployment env vars.
# Copy to `.env` next to docker-compose.prod.yml and fill in.
# DO NOT commit `.env`. The .gitignore in this repo blocks it.

# ── Required (docker compose blocks deploy if missing) ────────────────────────

# Postgres connection string for the proxy. The connecting role MUST be a
# LOGIN-capable user (e.g. `tankada`, the POSTGRES_USER below) that has the
# privilege to `SET LOCAL ROLE tankada_app`. The proxy switches role at runtime
# so PostgreSQL RLS is enforced via `tankada_app` (NOLOGIN) defined in init.sql.
# Example: postgres://tankada:STRONGPASS@postgres:5432/tankada?sslmode=disable
DATABASE_URL=

# Postgres bootstrap credentials. Used by the postgres service in
# docker-compose.override.yml (single-VPS demo). Must match the user/password
# embedded in DATABASE_URL above and the dbname in init.sql.
POSTGRES_USER=tankada
POSTGRES_PASSWORD=
POSTGRES_DB=tankada

# JWT verification (C.1.a). TWO MODES, mutually exclusive:
#
#   1) HS256 (symmetric, dev / single-tenant): set JWT_SECRET to a strong random
#      value (generate with `openssl rand -hex 32`) and leave JWT_JWKS_* empty.
#      The same secret signs and verifies, so it MUST match the JWT_SECRET set
#      in the dashboard environment.
#
#   2) RS256/JWKS (asymmetric, production / multi-tenant): the signer (control
#      plane / dashboard) keeps the private key; only the public keys ship to
#      the gateway as a JWKS. Set JWT_JWKS_URL (preferred) or JWT_JWKS_PATH and
#      leave JWT_SECRET empty. If both modes are configured, JWKS wins and
#      JWT_SECRET is ignored (with a warning).
#
# Generate a JWKS + matching private key for dev/test:
#   python sdk/python/generate_jwks.py --kid k1 \
#       --out-private private.pem --out-jwks jwks.json
JWT_SECRET=
JWT_JWKS_URL=
JWT_JWKS_PATH=
# Seconds between background refreshes of JWT_JWKS_URL (0 disables; minimum 30s
# honored). Has no effect when using JWT_JWKS_PATH (static file).
JWT_JWKS_REFRESH_SEC=300
# Per-tenant key isolation (C.1.b). When true, every JWK in the JWKS MUST carry
# a `tankada_tenant` field; the gateway then enforces that the token's
# tenant_id claim matches the kid's bound tenant. Untagged kids are rejected.
# Default (false) keeps backward-compat with C.1.a JWKS files that have no
# tenant tag yet -- untagged kids accept any tenant_id with a warning logged
# at most once per (kid, tenant_id) pair. Flip to true once you have tagged
# every JWK in the JWKS with --tenant (sdk/python/generate_jwks.py).
JWT_JWKS_REQUIRE_TENANT_BINDING=false

# Grafana admin credentials. Anonymous Grafana access is disabled; you must
# log in to view dashboards. The Grafana port is bound to 127.0.0.1 by the
# compose file so it is never publicly reachable; access via SSH tunnel.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# ── Optional (sensible defaults applied if unset) ─────────────────────────────

# Environment marker. Set to `development` only on a developer laptop.
# Any other value (including unset) is treated as production: the dashboard
# refuses to start with the default dev JWT secret, the gateway logs.Fatal
# on the same condition, and a few features assume hardened defaults.
TANKADA_ENV=production

# Per-agent rate limit (queries per minute). Set to 0 to disable.
RATE_LIMIT_QPM=60

# ── Telemetry (C.2.b, OPT-IN) ────────────────────────────────────────────────
# Periodic heartbeat to the vendor with VERSION + AGGREGATE COUNTERS only.
# Strictly NO per-query data: no SQL, no tenant_id, no agent_id, no table /
# column names, no audit log content, no JWTs / secrets. The exact payload
# is documented in gateway/telemetry/telemetry.go (Heartbeat struct).
#
# Disabled by default. To enable, set TANKADA_TELEMETRY_URL to the vendor
# endpoint you were given. To audit what would be sent without actually
# sending, set TANKADA_TELEMETRY_DRY_RUN=true and watch the gateway log.
TANKADA_TELEMETRY_URL=
TANKADA_TELEMETRY_TOKEN=
# Minimum 60s; default 3600 (one heartbeat per hour).
TANKADA_TELEMETRY_INTERVAL_SEC=3600
TANKADA_TELEMETRY_DRY_RUN=false
# Optional operator-chosen label, e.g. "acme-prod". Helps the vendor identify
# the deployment without exposing customer-internal identifiers.
TANKADA_SITE_ID=

# Optional webhook URL fired on every deny event (for SIEM / Slack / ops).
TANKADA_WEBHOOK_URL=

# Public-facing port for the gateway. Reverse-proxy (Caddy) terminates TLS
# and forwards to this port. Bind to localhost in a Caddy-fronted setup:
#   GATEWAY_PORT=127.0.0.1:8080
GATEWAY_PORT=8080

# Internal Grafana port. The compose file already prefixes `127.0.0.1:`, so
# this must be only the port number (NOT `127.0.0.1:3000`, that would produce
# an invalid `127.0.0.1:127.0.0.1:3000:3000` binding).
GRAFANA_PORT=3000

# ── Dashboard service (sdk/python/dashboard/server.py) ────────────────────────
# These are read by the dashboard process, not by docker compose. Set them
# in the same .env file that you `source` before launching `python server.py`,
# or pass via systemd `Environment=`.

# JWT_SECRET: same value as the gateway's JWT_SECRET above. The dashboard
#   signs agent tokens with it; the gateway rejects mismatched signatures.
# TANKADA_ENV: same as above. With the default dev secret + non-development,
#   the dashboard exits 1 at startup.
# GATEWAY_URL: where the dashboard sends queries. In a single-VPS deploy
#   behind Caddy, point this to the internal gateway URL, not the public one,
#   to avoid the round-trip back through TLS.
GATEWAY_URL=http://localhost:8080

# Public-facing dashboard port. Reverse-proxy (Caddy) terminates TLS and
# forwards to this port. Bind to localhost in a Caddy-fronted setup.
DASHBOARD_PORT=8090

# LLM provider used by the dashboard's agent demo scenarios.
# Supported: ollama (default, local), openai (requires LLM_API_KEY),
# anthropic (requires LLM_API_KEY).
LLM_PROVIDER=ollama
LLM_API_KEY=
# LLM_MODEL=  # optional override; defaults per-provider
