# Environment
.env
*.env
.env.*
!.env.example
!*.env.example

# Go binaries
gateway/gateway
proxy/proxy
*.exe

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
*.egg-info/

# Docker volumes
postgres_data/
grafana_data/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp

# Experiment outputs are regenerated locally; not tracked.
# The results/ directory is kept (via .gitkeep) so the harness scripts
# have a write target on clone.
experiments/results/*.csv

# Local-only experiment scratch (work-in-progress harnesses not ready to ship,
# e.g. extended seed generators with embedded fraud patterns). Lives on disk
# for reference but stays out of git.
experiments/scratch/

# D.4.b audit signing keys + signing-mode compose override.
# Operators generate these locally with `audit-keygen`; the private key must
# never be committed.
deploy/*.pem
deploy/docker-compose.signing.yml
